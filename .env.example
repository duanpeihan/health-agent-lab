# Optional local configuration; the application does not load .env files itself.
# To use this example in a shell: set -a; source .env.example; set +a
OLLAMA_HOST=http://127.0.0.1:11434

# Test-only fault injection must be disabled for ordinary API usage.
INJECT_BAD_FACT=0
INJECT_FALSE_CLAIM=0

# No cloud API key is required. Keep optional LangChain/LangSmith tracing off.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
